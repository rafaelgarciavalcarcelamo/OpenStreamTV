<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><corners android:radius="14dp"/><solid android:color="#3A2527"/><stroke android:width="3dp" android:color="#FFFFFF"/></shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle"><corners android:radius="14dp"/><solid android:color="@color/accent_dark"/><stroke android:width="1dp" android:color="@color/accent"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="14dp"/><solid android:color="@color/panel_raised"/><stroke android:width="1dp" android:color="#343434"/></shape>
    </item>
</selector>
